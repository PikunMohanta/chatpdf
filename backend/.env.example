# Backend Environment Variables# PDFPixie Environment Configuration

# Copy this file to .env and fill in your values# Copy this file to .env for local development

# Note: The app works without these in development mode with mock data

# Environment

ENVIRONMENT=development# =============================================================================

# OPTIONAL - Only needed for production or specific features

# Database (Supabase PostgreSQL)# =============================================================================

# Get from: https://supabase.com → Project Settings → Database → Connection String

DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxx.supabase.co:5432/postgres# OpenRouter API (for AI chat responses)

# Get your key from: https://openrouter.ai/

# AI API KeysOPENROUTER_API_KEY=your-openrouter-api-key-here

OPENROUTER_API_KEY=your_openrouter_api_key_hereOPENROUTER_MODEL=openai/gpt-3.5-turbo

OPENAI_API_KEY=your_openai_api_key_here  # Optional

# AWS S3 (for production PDF storage - not needed for local dev)

# AWS S3 Storage (Optional - for persistent file storage)AWS_ACCESS_KEY_ID=your-aws-access-key

AWS_ACCESS_KEY_ID=your_aws_access_key_idAWS_SECRET_ACCESS_KEY=your-aws-secret-key

AWS_SECRET_ACCESS_KEY=your_aws_secret_access_keyAWS_DEFAULT_REGION=us-east-1

AWS_REGION=ap-southeast-1S3_BUCKET_NAME=pdfpixie-documents

S3_BUCKET_NAME=pdfpixie-documents

# =============================================================================

# CORS (Frontend URL)# AUTO-CONFIGURED - These work out of the box for local development

FRONTEND_URL=http://localhost:5173  # Change to Vercel URL in production# =============================================================================


# Storage Directories (auto-created)
UPLOAD_DIR=./data/uploads
CHROMA_DIR=./data/chromadb
CHAT_HISTORY_DIR=./data/chat_history

# FastAPI Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS - Frontend URL
FRONTEND_URL=http://localhost:3000

# File Upload Limits
MAX_FILE_SIZE=50  # MB
ALLOWED_FILE_TYPES=pdf

# =============================================================================
# DEVELOPMENT MODE DEFAULTS
# =============================================================================
# ✅ Local file storage (./data/uploads/)
# ✅ ChromaDB for embeddings (./data/chromadb/)
# ✅ SQLite for chat history (./data/chat_history/)
# ✅ Mock authentication (no AWS Cognito needed)
# ✅ Works without any API keys!