# PDFPixie Frontend Environment Variables

# API Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=http://localhost:8000

# Application Configuration
VITE_APP_NAME=PDFPixie
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=AI-powered PDF analysis and chat

# Feature Flags
VITE_ENABLE_DEBUG=true
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_REPORTING=false
# Test document loading (disabled by default - set to 'true' for development convenience)
VITE_ENABLE_TEST_DOCUMENT=false

# Upload Configuration
VITE_MAX_FILE_SIZE=50
VITE_ALLOWED_FILE_TYPES=.pdf

# Performance
VITE_ENABLE_LAZY_LOADING=true
VITE_CHUNK_SIZE_WARNING=600

# Development
VITE_DEV_PORT=3000
VITE_DEV_HOST=localhost