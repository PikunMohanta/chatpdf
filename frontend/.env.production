# PDFPixie Frontend Production Environment Variables

# API Configuration - Updated for Render deployment
VITE_API_URL=https://pdfpixie-backend.onrender.com

# Application Configuration
VITE_APP_NAME=PDFPixie
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=AI-powered PDF analysis and chat

# Feature Flags
VITE_ENABLE_DEBUG=false
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_REPORTING=true
VITE_ENABLE_TEST_DOCUMENT=false

# Upload Configuration
VITE_MAX_FILE_SIZE=50
VITE_ALLOWED_FILE_TYPES=.pdf

# Performance
VITE_ENABLE_LAZY_LOADING=true
VITE_CHUNK_SIZE_WARNING=600

# Security
VITE_ENABLE_CSP=true
VITE_ENABLE_HTTPS_ONLY=true