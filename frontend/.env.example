# Frontend Environment Variables# Environment template - Copy this to .env.local and customize

# Copy this file to .env.local and fill in your values# Do not commit .env.local to version control



# Backend API URL# API Configuration

VITE_API_URL=http://localhost:8000  # Change to Render URL in productionVITE_API_BASE_URL=http://localhost:8000

VITE_WS_URL=http://localhost:8000

# Example for production:

# VITE_API_URL=https://pdfpixie-backend.onrender.com# Application Configuration

VITE_APP_NAME=PDFPixie
VITE_APP_VERSION=1.0.0

# Feature Flags (optional overrides)
# VITE_ENABLE_DEBUG=false
# VITE_MAX_FILE_SIZE=100

# Add your custom environment variables here
# VITE_CUSTOM_FEATURE=enabled
