# PDFPixie Environment Configuration
# EC2 Production Settings

# Application Settings
ENVIRONMENT=production
DEBUG=false
IS_PRODUCTION=true

# API Keys (REQUIRED - Add your actual key)
OPENROUTER_API_KEY=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

# Domain Configuration (Replace with your DuckDNS domain)
DOMAIN_NAME=your-subdomain.duckdns.org
FRONTEND_URL=http://your-subdomain.duckdns.org

# Database Settings (PostgreSQL container)
POSTGRES_USER=pdfpixie_user
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PASSWORD_IN_PRODUCTION
POSTGRES_DB=pdfpixie

# Database URL (for FastAPI to connect to PostgreSQL container)
DATABASE_URL=postgresql://pdfpixie_user:CHANGE_THIS_SECURE_PASSWORD_IN_PRODUCTION@postgres:5432/pdfpixie

# Redis Settings (Redis container)
REDIS_URL=redis://redis:6379/0

# AWS S3 (Optional - leave empty if using local storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
AWS_REGION=ap-south-1

# Logging
LOG_LEVEL=INFO

# Security (Add if implementing HTTPS)
# SSL_CERT_PATH=/etc/letsencrypt/live/your-subdomain.duckdns.org/fullchain.pem
# SSL_KEY_PATH=/etc/letsencrypt/live/your-subdomain.duckdns.org/privkey.pem
