# PDFPixie Environment Variables Example
# Copy to .env and adjust values before running in production.

# ==== Application Basics ====
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=change_me_to_a_long_random_hex
FRONTEND_URL=http://localhost

# ==== API Keys / AI Providers ====
OPENROUTER_API_KEY=your_openrouter_key_here
OPENAI_API_KEY=your_openai_key_here
# BEDROCK credentials rely on AWS env vars below

# ==== AWS / S3 (optional for file storage) ====
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# ==== Database (PostgreSQL) ====
# Format: postgresql+psycopg://user:password@host:port/dbname or async versions
DATABASE_URL=sqlite:///./data/database/app.db
# For production with Postgres:
# DATABASE_URL=postgresql://pdfpixie_user:pdfpixie_password@postgres:5432/pdfpixie

# ==== Redis (optional caching / Celery broker) ====
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ==== Performance Tuning ====
MAX_WORKERS=1
WORKER_TIMEOUT=300

# ==== Security / CORS ====
ALLOWED_ORIGINS=http://localhost,http://localhost:5173

# ==== Logging ====
LOG_LEVEL=info

# ==== Feature Flags ====
ENABLE_EMBEDDINGS=true
ENABLE_PDF_TABLE_EXTRACTION=false

# ==== Misc ====
# Additional custom environment variables can be added below.
